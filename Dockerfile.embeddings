ARG PYTHON_IMAGE=python:3.12.15-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2
FROM ${PYTHON_IMAGE}
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY requirements-local-models.txt ./
RUN pip install --no-cache-dir -r requirements-local-models.txt --extra-index-url https://download.pytorch.org/whl/cpu \
    && useradd --uid 1000 --create-home embeddings
COPY services/embeddings/server.py ./server.py
USER embeddings
CMD ["python", "server.py"]
