# Endpoint compatível com OpenAI; Groq é apenas o exemplo abaixo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_RETRIES=1
# GROQ_API_KEY e GROQ_MODEL são aliases legados.
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
PORT=3333

# Open intranet mode: leave ADMIN_API_TOKEN and CORS_ORIGINS empty.
ADMIN_API_TOKEN=
CORS_ORIGINS=
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_URL=http://localhost:8001
EMBEDDING_MODEL=tardellirs/embeddinggemma-pt-br
EMBEDDING_REVISION=e7d1031ee97db28c3e6f87d309cca552e1481622
EMBEDDING_MODEL_PATH=./data/models/embeddinggemma-pt-br
EMBEDDING_DIMENSIONS=768
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
COMPOSE_PROFILES=embeddinggemma
EMBEDDING_PORT=8001
LOCAL_MODEL_THREADS=2
EMBEDDING_MAX_BODY_BYTES=65536
QDRANT_COLLECTION=legislacao_visa_embeddinggemma_pt_br
REQUEST_TIMEOUT_MS=120000
CHAT_TIMEOUT_MS=180000
SEARCH_LIMIT=6
SEARCH_SCORE_THRESHOLD=0.3
MAX_HISTORY_TOKENS=5000
MAX_RESPONSE_TOKENS=1000
UPLOAD_MAX_BYTES=26214400
INGESTION_WORKER_IN_API=true
WORKER_LEASE_MS=30000
WORKER_POLL_MS=1000
CONVERSATION_TTL_MS=86400000
# DATABASE_PATH=data/database.sqlite
# PDF_DIR=data/pdfs
TRUST_PROXY_HOPS=0

QDRANT_API_KEY=
EMBEDDING_CONTEXT_TOKENS=2048
INGESTION_BATCH_SIZE=25
CHUNK_MAX_LENGTH=2500
CHUNK_OVERLAP=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

