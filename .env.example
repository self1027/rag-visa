# Endpoint compatível com OpenAI; Groq é apenas o exemplo abaixo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_RETRIES=1
# GROQ_API_KEY e GROQ_MODEL são aliases legados.
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
PORT=3333

# Open intranet mode: leave ADMIN_API_TOKEN and CORS_ORIGINS empty.
ADMIN_API_TOKEN=
CORS_ORIGINS=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
QDRANT_COLLECTION=legislacao_visa
REQUEST_TIMEOUT_MS=120000
CHAT_TIMEOUT_MS=180000
SEARCH_LIMIT=6
SEARCH_SCORE_THRESHOLD=0.3
MAX_HISTORY_TOKENS=5000
MAX_RESPONSE_TOKENS=1000
UPLOAD_MAX_BYTES=26214400
INGESTION_WORKER_IN_API=true
WORKER_LEASE_MS=30000
WORKER_POLL_MS=1000
CONVERSATION_TTL_MS=86400000
# DATABASE_PATH=data/database.sqlite
# PDF_DIR=data/pdfs
TRUST_PROXY_HOPS=0

QDRANT_API_KEY=
EMBEDDING_CONTEXT_TOKENS=8192
INGESTION_BATCH_SIZE=25
CHUNK_MAX_LENGTH=2500
CHUNK_OVERLAP=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Imagens substituíveis; lockfile e referências fixas garantem reprodução.
NODE_IMAGE=node:24.21.0@sha256:9af606de2e947cfb3f276633b7c5130c4cd22365aa10f5a647b7675d5cfce0c0
